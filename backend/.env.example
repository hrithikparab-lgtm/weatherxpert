# WeatherXpert Backend — copy to .env and fill in values

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-here-change-this

# PostgreSQL connection string
# Local: postgresql+asyncpg://postgres:password@localhost:5432/weatherxpert
# Render: automatically injected from the database service
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/weatherxpert

# Weather API keys
TOMORROW_IO_API_KEY=your-tomorrow-io-key-here
IMD_API_KEY=your-imd-key-here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Set to true for detailed SQLAlchemy logs
DEBUG=false
